SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local runs (no Docker): point at localhost.
# Docker Compose overrides DATABASE_URL and OLLAMA_URL for the web service
# (db:5432 / ollama:11434).
DATABASE_URL=postgres://kb_user:change-me-in-production@localhost:5432/knowledge_base

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1
OLLAMA_READ_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=5
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.3
CONTEXT_CHAR_LIMIT=10000

POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change-me-in-production